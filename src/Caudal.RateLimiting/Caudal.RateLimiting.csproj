<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Caudal</RootNamespace>
    <AssemblyName>Caudal.RateLimiting</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Rate limiting for Caudal flows over System.Threading.RateLimiting: pace a pipeline globally or per key with backpressure instead of buffering.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caudal.Core\Caudal.Core.csproj" />
  </ItemGroup>

</Project>
